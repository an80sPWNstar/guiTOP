{
  "name": "guitop",
  "version": "0.3.7",
  "description": "guiTOP — a desktop GUI for NVIDIA GPU monitoring (local + multi-host over SSH)",
  "author": "an80sPWNstar <an80sPWNstar@users.noreply.github.com>",
  "license": "MIT",
  "homepage": "https://github.com/an80sPWNstar/guiTOP",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/an80sPWNstar/guiTOP.git"
  },
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "build": "electron-builder --win",
    "build:dir": "electron-builder --win --dir",
    "build:win": "cmd.exe /c \"$(wslpath -w .)\\build-win.bat\"",
    "build:linux": "electron-builder --linux",
    "test": "node test/run.js",
    "probe": "node tools/gpu-probe.js"
  },
  "devDependencies": {
    "electron": "^31.7.7",
    "electron-builder": "^25.1.8"
  },
  "dependencies": {
    "ssh2": "^1.16.0"
  },
  "build": {
    "appId": "com.guitop.app",
    "productName": "guiTOP",
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "renderer/**/*",
      "styles/**/*",
      "assets/**/*",
      "!renderer/skins/gauges.js",
      "!node_modules/cpu-features/**"
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/images/app-icon.ico"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Utility",
      "icon": "assets/images/app-icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": false
    }
  }
}
